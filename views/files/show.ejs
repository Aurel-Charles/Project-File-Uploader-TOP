<%- include('../partials/header', { title: file.originalName }) %>

<% const backUrl = file.folderId ? `/folders/${file.folderId}` : '/folders' %>

<div class="toolbar">
  <div class="toolbar-title">
    <a href="<%= backUrl %>" class="back-link" aria-label="Back"><i data-lucide="arrow-left" aria-hidden="true"></i></a>
    <h1 class="folder-title"><%= file.originalName %></h1>
  </div>
</div>

<div class="file-layout">
  <section class="file-preview" aria-label="Preview">
    <% if (previewUrl) { %>
      <img src="<%= previewUrl %>" alt="Preview of <%= file.originalName %>">
    <% } else { %>
      <div class="file-preview-placeholder">
        <i data-lucide="<%= file.mimeType === 'application/pdf' ? 'file-text' : 'file' %>" aria-hidden="true"></i>
        <p>No preview available</p>
      </div>
    <% } %>
  </section>

  <aside class="file-panel" aria-label="File details">
    <dl class="file-details">
      <dt>Size</dt>
      <dd><%= formatSize(file.size) %></dd>

      <dt>Type</dt>
      <dd><%= file.mimeType %></dd>

      <dt>Uploaded</dt>
      <dd><%= file.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></dd>
    </dl>

    <a href="/files/<%= file.id %>/download"><i data-lucide="download" aria-hidden="true"></i>Download</a>

    <form action="/files/<%= file.id %>/delete" method="POST">
      <button type="submit"><i data-lucide="trash" aria-hidden="true"></i>Delete file</button>
    </form>
  </aside>
</div>

<%- include('../partials/footer') %>
