<%- include('../partials/header', { title: file.originalName }) %>

<h1 class="folder-title"><i data-lucide="file" aria-hidden="true"></i><%= file.originalName %></h1>

<dl class="file-details">
  <dt>Name</dt>
  <dd><%= file.originalName %></dd>

  <dt>Size</dt>
  <dd><%= formatSize(file.size) %></dd>

  <dt>Type</dt>
  <dd><%= file.mimeType %></dd>

  <dt>Uploaded</dt>
  <dd><%= file.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></dd>
</dl>

<a href="/files/<%= file.id %>/download"><i data-lucide="download" aria-hidden="true"></i>Download</a>

<form action="/files/<%= file.id %>/delete" method="POST">
  <button type="submit"><i data-lucide="trash" aria-hidden="true"></i>Delete</button>
</form>

<a href="<%= file.folderId ? `/folders/${file.folderId}` : '/folders' %>"><i data-lucide="arrow-left" aria-hidden="true"></i>Back</a>

<%- include('../partials/footer') %>