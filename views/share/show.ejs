<%- include('../partials/header', { title: folder.name }) %>

<div class="share-banner">
  <span class="share-banner-icon"><i data-lucide="folder-open" aria-hidden="true"></i></span>
  <div class="share-banner-text">
    <p class="share-banner-label">Shared folder</p>
    <h1><%= folder.name %></h1>
  </div>
  <p class="share-banner-expiry">
    <i data-lucide="clock" aria-hidden="true"></i>
    Expires <%= share.expiresAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %>
  </p>
</div>

<% if (!folder.files.length) { %>
  <p class="empty">This folder is empty.</p>
<% } %>

<ul class="share-files">
  <% folder.files.forEach(file => { %>
    <li class="share-file">
      <span class="share-file-icon"><i data-lucide="file" aria-hidden="true"></i></span>
      <h2><%= file.originalName %></h2>
      <p>
        <%= formatSize(file.size) %>
        · <%= file.createdAt.toLocaleString('en-GB', { dateStyle: 'medium' }) %>
      </p>
      <a href="/share/<%= share.id %>/files/<%= file.id %>/download"><i data-lucide="download" aria-hidden="true"></i>Download</a>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
