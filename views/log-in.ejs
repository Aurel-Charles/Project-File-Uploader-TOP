<%- include('partials/header', { title: 'Log in' }) %>

<div class="auth-card">
  <div class="auth-logo"><i data-lucide="hard-drive" aria-hidden="true"></i></div>
  <h1>Log in</h1>
  <p class="auth-subtitle">Welcome back to File Uploader.</p>

  <% if (locals.messages?.length) { %>
    <p class="errors"><%= messages.at(-1) %></p>
  <% } %>

  <form action="/log-in" method="POST">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= locals.values?.email ?? '' %>" autocomplete="email" required>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>

    <button type="submit"><i data-lucide="log-in" aria-hidden="true"></i>Log in</button>
  </form>

  <p class="auth-switch">Not a member? <a href="/sign-up">Sign up</a></p>
</div>

<%- include('partials/footer') %>
