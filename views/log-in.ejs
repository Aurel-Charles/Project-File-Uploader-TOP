<%- include('partials/header', { title: 'Log in' }) %>

<h1>Log in</h1>

<% if (locals.messages?.length) { %>
    <p class="errors"><%= messages.at(-1) %></p>
  <% } %>

<form action="/log-in" method="POST">

  <label for="email">Email</label>
  <input type="email" id="email" name="email" value="<%= locals.values?.email ?? '' %>" required>

  <label for="password">Password</label>
  <input type="password" id="password" name="password" required>

  <button type="submit">Submit</button>
</form>

<p>Not a member? <a href="/sign-up">Sign up</a></p>

<%- include('partials/footer') %>