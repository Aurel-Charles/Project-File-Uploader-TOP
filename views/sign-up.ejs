<%- include('partials/header', { title: 'Sign up' }) %>

<div class="auth-card">
  <div class="auth-logo"><i data-lucide="hard-drive" aria-hidden="true"></i></div>
  <h1>Sign up</h1>
  <p class="auth-subtitle">Create your account to start storing files.</p>

  <% if (locals.errors?.length) { %>
    <ul class="errors">
      <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/sign-up" method="POST">
    <div class="auth-row">
      <div>
        <label for="firstname">First name</label>
        <input type="text" id="firstname" name="firstname" value="<%= locals.values?.firstname ?? '' %>" autocomplete="given-name" required>
      </div>
      <div>
        <label for="lastname">Last name</label>
        <input type="text" id="lastname" name="lastname" value="<%= locals.values?.lastname ?? '' %>" autocomplete="family-name" required>
      </div>
    </div>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= locals.values?.email ?? '' %>" autocomplete="email" required>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="new-password" required>

    <label for="confirmPassword">Confirm password</label>
    <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required>

    <button type="submit"><i data-lucide="user-plus" aria-hidden="true"></i>Create account</button>
  </form>

  <p class="auth-switch">Already a member? <a href="/log-in">Log in</a></p>
</div>

<%- include('partials/footer') %>
