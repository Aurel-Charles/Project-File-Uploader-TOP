<%- include('../partials/header', { title: folder.name }) %>

<h1 class="folder-title"><i data-lucide="folder-open" aria-hidden="true"></i><%= folder.name %></h1>

<% if (locals.errors?.length) { %>
  <ul class="errors">
    <% errors.forEach(err => { %>
      <li><%= err.msg %></li>
    <% }) %>
  </ul>
<% } %>

<div class="folder-layout">
  <section class="folder-main" aria-label="Files">
    <form action="/folders/<%= folder.id %>/files" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" required>
      <button type="submit"><i data-lucide="upload" aria-hidden="true"></i>Upload</button>
    </form>

    <% if (!files.length) { %>
      <p>This folder is empty.</p>
    <% } %>

    <ul class="files">
      <% files.forEach(file => { %>
        <li class="file">
          <h2>
            <a href="/files/<%= file.id %>"><i data-lucide="file" aria-hidden="true"></i><%= file.originalName %></a>
          </h2>
          <p><%= file.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></p>

          <form action="/files/<%= file.id %>/delete" method="POST">
            <button type="submit"><i data-lucide="trash" aria-hidden="true"></i>Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>

    <a href="/folders"><i data-lucide="arrow-left" aria-hidden="true"></i>Back</a>
  </section>

  <aside class="share-panel" aria-labelledby="share-title">
    <h2 class="folder-title" id="share-title"><i data-lucide="share-2" aria-hidden="true"></i>Share links</h2>

    <form action="/folders/<%= folder.id %>/share" method="POST">
        <select name="duration" id="duration">
            <option value="1">1 day</option>
            <option value="7">7 days</option>
            <option value="30">30 days</option>
        </select>
      <button type="submit"><i data-lucide="link" aria-hidden="true"></i>Create share link</button>
    </form>

    <% if (!shares.length) { %>
      <p>No active share links.</p>
    <% } %>

    <ul class="shares">
      <% shares.forEach(share => { %>
        <% const shareUrl = `${urlBase}share/${share.id}` %>
        <li class="share">
          <input type="text" value="<%= shareUrl %>" readonly>
          <a href="<%= shareUrl %>" target="_blank" rel="noopener"><i data-lucide="external-link" aria-hidden="true"></i>Open</a>
          <button data-share="<%= shareUrl %>" type="button" aria-label="Copy link">
            <i data-lucide="copy" aria-hidden="true"></i>
            <i data-lucide="check" aria-hidden="true" hidden></i>
          </button>
          <form action="/folders/<%= folder.id %>/shares/<%= share.id %>/delete" method="POST">
            <button type="submit" aria-label="Delete share link"><i data-lucide="trash" aria-hidden="true"></i></button>
          </form>
          <p>
            Expires
            <%= share.expiresAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %>
          </p>
        </li>
      <% }) %>
    </ul>
  </aside>
</div>

<%- include('../partials/footer') %>