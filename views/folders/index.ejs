<%- include('../partials/header', { title: 'My drive' }) %>

<div class="drive-layout">
  <aside class="drive-sidebar" aria-label="Drive actions">
    <a href="/folders/new"><i data-lucide="folder-plus" aria-hidden="true"></i>New folder</a>

    <form action="/files" method="POST" enctype="multipart/form-data">
      <p class="upload-title">Upload to My drive</p>
      <label class="file-picker">
        <input type="file" name="file" title="" required>
        <i data-lucide="file-up" aria-hidden="true"></i>
        <span class="file-picker-name">Choose a file</span>
      </label>
      <button type="submit"><i data-lucide="upload" aria-hidden="true"></i>Upload</button>
    </form>
  </aside>

  <section class="drive-main">
    <div class="toolbar">
      <h1 class="folder-title"><i data-lucide="hard-drive" aria-hidden="true"></i>My drive</h1>
      <p class="toolbar-meta">
        <%= folders.length %> <%= folders.length === 1 ? 'folder' : 'folders' %>
        · <%= files.length %> <%= files.length === 1 ? 'file' : 'files' %>
      </p>
    </div>

    <h2 class="section-title">Folders</h2>

    <% if (!folders.length) { %>
      <p class="empty">No folders yet.</p>
    <% } %>

    <ul class="folders">
      <% folders.forEach(folder => { %>
        <li class="folder">
          <h2>
            <a href="/folders/<%= folder.id %>"><i data-lucide="folder" aria-hidden="true"></i><%= folder.name %></a>
          </h2>
          <p><%= folder.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></p>

          <a href="/folders/<%= folder.id %>/edit"><i data-lucide="pencil" aria-hidden="true"></i>Edit</a>
          <form action="/folders/<%= folder.id %>/delete" method="POST">
            <button type="submit"><i data-lucide="trash" aria-hidden="true"></i>Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>

    <h2 class="section-title">Files</h2>

    <% if (!files.length) { %>
      <p class="empty">No files at the root yet.</p>
    <% } %>

    <ul class="files">
      <% files.forEach(file => { %>
        <li class="file">
          <h2>
            <a href="/files/<%= file.id %>"><i data-lucide="file" aria-hidden="true"></i><%= file.originalName %></a>
          </h2>
          <p><%= file.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></p>

          <form action="/files/<%= file.id %>/delete" method="POST">
            <button type="submit"><i data-lucide="trash" aria-hidden="true"></i>Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<%- include('../partials/footer') %>
